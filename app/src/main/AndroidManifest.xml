<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Интернет для API электронной очереди -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Уведомления Android 13+ -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Работа Foreground Service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Foreground Service для передачи данных/сети -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Не даём CPU полностью заснуть во время мониторинга -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />


    <application

        android:allowBackup="true"

        android:icon="@drawable/queuewatch_icon"

        android:roundIcon="@drawable/queuewatch_icon"

        android:label="QueueWatch"

        android:supportsRtl="true"

        android:theme="@android:style/Theme.Material.Light.NoActionBar">


        <activity

            android:name=".MainActivity"

            android:exported="true">


            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- =================================================
             ФОНОВЫЙ МОНИТОРИНГ
             ================================================= -->

        <service

            android:name=".QueueWatchService"

            android:enabled="true"

            android:exported="false"

            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
