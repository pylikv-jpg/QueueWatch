<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Интернет для API электронной очереди -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Уведомления Android 13+ -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Работа Foreground Service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Длительный пользовательский мониторинг очереди, не ограниченный 6 часами dataSync -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Восстановление активного отслеживания после перезагрузки телефона -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Не даём CPU полностью заснуть во время мониторинга -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />


    <application

        android:allowBackup="true"

        android:icon="@drawable/queuewatch_icon"

        android:roundIcon="@drawable/queuewatch_icon"

        android:label="QueueWatch"

        android:supportsRtl="true"

        android:theme="@android:style/Theme.Material.Light.NoActionBar">


        <activity

            android:name=".MainActivity"

            android:exported="true">


            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- =================================================
             ФОНОВЫЙ МОНИТОРИНГ
             ================================================= -->

        <service

            android:name=".QueueWatchService"

            android:enabled="true"

            android:exported="false"

            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started continuous border queue position monitoring with time-critical position and vehicle-call alerts; interruption can cause the user to miss a border crossing call." />

        </service>


        <!-- Восстановление пользовательского мониторинга после перезагрузки/обновления -->
        <receiver
            android:name=".QueueWatchBootReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>
